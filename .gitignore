# ===== SECRETS — never commit =====
.env
.env.*
!.env.example
*.keystore
*.jks
*.pem
local.properties
secrets/
# Spotify OAuth refresh token and librespot's credential cache. The refresh
# token is, in practice, permanent -- it IS the account.
server/spotify_creds/

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/

# ===== Android / Gradle =====
.gradle/
build/
captures/
EchoTerminal/.gradle/
EchoTerminal/build/
EchoTerminal/app/build/
EchoTerminal/local.properties

# ===== IDE / OS =====
.idea/
*.iml
.vscode/
Thumbs.db
.DS_Store

# ===== Runtime artifacts =====
*.log
server/data/
server/recordings/
# The librespot binary is fetched per-machine, not committed (~15 MB, and the
# Windows build is not the one a Linux checkout wants).
tools/librespot*

server/memory/jarvis.json
