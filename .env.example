# echo-server configuration template.
#
#   Copy to .env at the repo root and fill in.  .env is gitignored; this file
#   is committed and must NEVER contain a real key or secret.
#
#     cp .env.example .env          # PowerShell: Copy-Item .env.example .env
#
# Real environment variables take precedence over this file, so the Windows
# service environment can override anything here.

# =============================================================================
# Listener
# =============================================================================
# 0.0.0.0 listens on every interface. On a machine that is also on an untrusted
# LAN, set this to the Tailscale IP instead (e.g. 100.x.y.z) so the only route
# in is the tailnet.
ECHO_HOST=0.0.0.0
ECHO_PORT=8765

# REQUIRED. The device must send this as the X-Echo-Secret header on the
# WebSocket handshake. There is deliberately no default -- the server refuses to
# start without it. Generate one with:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The same value goes into the Kotlin client's SHARED_SECRET.
ECHO_SHARED_SECRET=replace-me-with-a-generated-secret

# Seconds between application-level pings on the device link.
ECHO_HEARTBEAT_INTERVAL_S=15

# Require the same secret on POST /display (as X-Shared-Secret). Set false only
# if a trusted script on this same machine is the sole caller.
ECHO_DISPLAY_REQUIRE_SECRET=true

# =============================================================================
# Gemini Live
# =============================================================================
# Leave EMPTY to run without Gemini. The device link, heartbeat, wake word and
# POST /display all still work; only the conversation leg is inert. This is a
# supported mode, useful for bringing up the client before you have a key.
GEMINI_API_KEY=

# The Live model line has been renamed repeatedly. Confirm the current id at
# https://ai.google.dev/api/live before assuming this one still resolves.
GEMINI_MODEL=gemini-3.1-flash-live-preview

# Prebuilt voice name (Puck, Charon, Kore, Fenrir, Aoede, ...).
GEMINI_VOICE=Puck

# LOW | MEDIUM | HIGH -- how much of the token budget camera frames consume.
GEMINI_MEDIA_RESOLUTION=MEDIUM

# System instruction, inline or from a file. Inline wins if both are set.
# GEMINI_SYSTEM_INSTRUCTION=You are a kitchen display assistant. Be brief.
# GEMINI_SYSTEM_INSTRUCTION_FILE=server/prompt.txt

# Close the Live session after this many seconds without speech. Live bills for
# the whole time a session is open, so this is cost control, not polish.
SESSION_IDLE_TIMEOUT=120

# Hard ceiling on one session regardless of activity. 0 disables.
SESSION_MAX_DURATION=600

# Trailing silence after which the server closes the user's turn explicitly
# (the Live API does not auto-end turns for realtime audio input). 0 disables.
SESSION_END_TURN_SILENCE_S=1.2

# How long the session waits AFTER the model has finished answering before it
# closes itself and the display returns to the clock. This is the one that makes
# a quick question feel finished: ask, get the answer, and about eight seconds
# later the device is a clock again -- rather than holding a billed session, and
# a live microphone, open for the full SESSION_IDLE_TIMEOUT while you walk away.
#
# It can never cut an answer short: the countdown starts only once the model has
# stopped speaking, and any further speech, tap or tool call cancels it. Tapping
# the screen buys another 30 seconds. 0 disables the window entirely, leaving
# SESSION_IDLE_TIMEOUT as the only close.
POST_ANSWER_SILENCE_S=8

# =============================================================================
# Wake word (openWakeWord, ONNX Runtime, server-side)
# =============================================================================
WAKE_ENABLED=true

# A bundled model name (alexa, hey_jarvis, hey_mycroft, hey_rhasspy) or a path
# to a custom .onnx.
WAKE_MODEL=alexa

# 0-1. Raise it if the room's TV sets it off; lower it if the Show's weak single
# microphone keeps missing you. Tune against recordings, not by guessing --
# see RECORD_AUDIO_DIR below.
WAKE_THRESHOLD=0.5

# Seconds after a trigger during which another cannot fire.
WAKE_REFRACTORY_S=2.0

# Fetch the ONNX models on first run. Set false on an air-gapped machine once
# they are already present.
WAKE_DOWNLOAD_MODELS=true

# =============================================================================
# Vision
# =============================================================================
# off       : the camera never opens.
# on_demand : the model opens it itself via the start_camera tool, and closes it
#             with stop_camera. This is the default.
# always    : frames stream for the whole session.
VISION_MODE=on_demand

# The Live API caps video at 1 FPS; higher values are clamped.
VISION_FPS=1.0
VISION_JPEG_QUALITY=80

# =============================================================================
# Ambient weather (Open-Meteo, no API key, no account)
# =============================================================================
# The device has no internet of its own -- everything reaches it over the
# tailnet link -- so the server fetches the weather and pushes it down for the
# home screen. Failures keep the last value; the card shows a placeholder until
# the first successful fetch.
WEATHER_ENABLED=true

# Where to report the weather for. Defaults are Syracuse, NY.
WEATHER_LAT=43.0481
WEATHER_LON=-76.1474

# Seconds between fetches. Open-Meteo updates hourly, so there is nothing to
# gain below this; values under 60 are clamped.
WEATHER_POLL_S=600

# =============================================================================
# Device tuning
# =============================================================================
# Software gain the device applies to mic audio before uplink. The real value
# comes from the Phase 3 measurement -- see docs/HARDWARE-STATUS.md. 1.0 is a
# placeholder, not a measurement.
MIC_GAIN=1.0

# Maximum wait for the device's confirmed alarm/timer state (seconds).
ALARM_ACK_TIMEOUT_S=3

# =============================================================================
# Diagnostics
# =============================================================================
LOG_LEVEL=INFO

# Set a directory to log raw 16 kHz PCM16 mic audio for offline wake-word
# tuning. Leave empty to disable. This records everything the microphone hears
# -- treat the directory accordingly.
# RECORD_AUDIO_DIR=server/recordings
